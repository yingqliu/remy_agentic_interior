# SQLite file used by Prisma. `file:./dev.db` is stored at prisma/dev.db
# (Prisma CLI resolves it relative to the schema; the app normalizes the same path).
# Swap the datasource provider to "postgresql" and point this at Postgres
# when you leave local development. JSON columns are Prisma Json on both.
DATABASE_URL="file:./dev.db"

# OpenAI Images API (gpt-image-1). When set, generation calls
# POST https://api.openai.com/v1/images/generations. Leave blank to use the
# stub provider, which records the prompt and does not invent a render.
# Never commit a real key.
OPENAI_API_KEY=""

# Optional generic OpenAI-compatible adapter. Used only when OPENAI_API_KEY
# is blank and both IMAGE_API_BASE and IMAGE_API_KEY are set.
IMAGE_API_BASE=""
IMAGE_API_KEY=""
IMAGE_API_MODEL=""

# Reserved for a future session implementation. Login is a placeholder and
# does not read this value yet.
AUTH_SECRET=""

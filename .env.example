# Copy to .env and set ARK_API_KEY and GEMINI_API_KEY. Every other value is already set.
# Those two keys are the only empty values. Do not commit a real key.
DATABASE_URL="file:./dev.db"
IMAGE_PROVIDER="seedream"
ARK_API_KEY=""
SEEDREAM_API_BASE="https://ark.cn-beijing.volces.com/api/v3"
SEEDREAM_MODEL="doubao-seedream-5-0-pro-260628"
SEEDREAM_SIZE="2K"
SEEDREAM_RESPONSE_FORMAT="b64_json"
SEEDREAM_OUTPUT_FORMAT="jpeg"
SEEDREAM_WATERMARK="false"
SEEDREAM_REFERENCE_PHOTO="public/seed/fan/fan-before.jpg"
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="gemini-nano-banana-2.1"
GEMINI_ASPECT_RATIO="3:2"
GEMINI_IMAGE_SIZE="2K"
GEMINI_REFERENCE_PHOTO="public/seed/fan/fan-before.jpg"
IMAGE_API_BASE="https://api.openai.com/v1"
IMAGE_API_KEY="unused-when-provider-is-seedream"
IMAGE_API_MODEL="gpt-image-2.6-flare"
IMAGE_API_QUALITY="medium"

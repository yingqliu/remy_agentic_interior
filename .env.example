# SQLite file used by Prisma. `file:./dev.db` is stored at prisma/dev.db
# (Prisma CLI resolves it relative to the schema; the app normalizes the same path).
# Swap the datasource provider to "postgresql" and point this at Postgres
# when you leave local development. JSON columns are Prisma Json on both.
DATABASE_URL="file:./dev.db"

# Image generation. Leave IMAGE_PROVIDER blank to use the stub, which records
# the prompt and does not invent a render. Never commit a real key.
#
# Gemini Nano Banana 2.1 (model id verified in the Gemini API docs):
#   https://ai.google.dev/gemini-api/docs/pricing
#   https://ai.google.dev/gemini-api/docs/image-generation
# Both IMAGE_PROVIDER and GEMINI_API_KEY are required. Output is 2K, 3:2.
# IMAGE_PROVIDER="gemini"
# GEMINI_API_KEY="paste-your-key-here"
# GEMINI_IMAGE_MODEL="gemini-nano-banana-2.1"
IMAGE_PROVIDER=""
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="gemini-nano-banana-2.1"

# OpenAI-compatible adapter. Used only when Gemini is not selected and both
# IMAGE_API_BASE and IMAGE_API_KEY are set. Default model is gpt-image-2.6-flare.
# IMAGE_API_QUALITY is sent as the images API `quality` field (low, medium, high, auto).
IMAGE_API_BASE=""
IMAGE_API_KEY=""
IMAGE_API_MODEL=""
IMAGE_API_QUALITY="medium"

# Reserved for a future session implementation. Login is a placeholder and
# does not read this value yet.
AUTH_SECRET=""
